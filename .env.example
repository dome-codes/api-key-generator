# =============================================================================
# Beispiel .env für API Key Generator Frontend
# Kopiere nach .env.local und passe die Werte an.
# =============================================================================

# -----------------------------------------------------------------------------
# API (Backend)
# -----------------------------------------------------------------------------
# Mock / Lokal:
# VITE_API_BASE_URL=http://localhost:3001/v1
#
# Echte API (Staging/Produktion):
VITE_API_BASE_URL=https://api.example.com/v1

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
# Lokaler Keycloak:
# VITE_KEYCLOAK_URL=http://localhost:8080
#
# Echter Keycloak (Staging/Produktion):
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=api-key-generator
VITE_KEYCLOAK_CLIENT_ID=api-key-generator-frontend

# WICHTIG: Mit echter API Keycloak nutzen (Login-Page wird angezeigt):
VITE_BYPASS_KEYCLOAK=false

# -----------------------------------------------------------------------------
# Optional (nur für lokale Mock-API ohne Keycloak)
# -----------------------------------------------------------------------------
# Keycloak überspringen (nur für lokale Entwicklung ohne Keycloak):
# VITE_BYPASS_KEYCLOAK=true
#
# Debug-Logs in der Konsole:
# VITE_SHOW_DEBUG=true
#
# App-Base-Path (falls nicht unter /admin-console):
# VITE_APP_BASE_PATH=/admin-console
